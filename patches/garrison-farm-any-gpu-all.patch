+                try:
+                    # 画面基本没变 -> 动画结束，界面稳定
+                    diff = float(cv2.absdiff(prev, img).mean())
+                    if diff < 2.0:
+                        return True
+                except Exception:
+                    return True
+            prev = img
+        else:
+            prev = None
+        time.sleep(0.35)
+    return False
 
 
