+def _mumu_extras_config(cfg):
+    """为 MuMu 打开 maafw 的原生加速通道（extras.mumu.enable）。
+
+    这是截图/触控提速的关键：开启后 maafw 直接调用 MuMu 的 nemu_capture_display
+    （共享内存取帧），实测截图从 ~300ms 降到 ~17ms；触控走 nemu_input_event_*。
+    不开启时 maafw 只能走 adb 通道，即使指定 EmulatorExtras 也会被忽略
+    （DLL 内部有 "extras.mumu.enable is false, ignore" 分支）。
+    与显卡无关：这是模拟器侧的共享内存直连，A卡/N卡都一样。
+    """
+    try:
+        idx = 0
+        if "instance_index" in cfg and isinstance(cfg["instance_index"], int):
+            idx = cfg["instance_index"]
+        # 自动定位 MuMu 安装目录
+        for p in (cfg.get("mumu_path"), os.environ.get("MUMU_PATH")):
+            if p and os.path.isdir(p):
+                break
+        else:
+            p = None
+            for cand in (r"D:\Program Files\MuMuPlayer", r"C:\Program Files\MuMuPlayer",
+                         r"C:\Program Files\MuMu", r"E:\Program Files\MuMuPlayer"):
+                if os.path.isdir(cand):
+                    p = cand
+                    break
+        ex = dict(cfg.get("extras") or {})
+        mumu = dict(ex.get("mumu") or {})
+        mumu["enable"] = True
+        if p:
+            mumu["path"] = p
+        mumu.setdefault("index", idx)
+        ex["mumu"] = mumu
+        out = dict(cfg)
+        out["extras"] = ex
+        return out, mumu.get("path")
+    except Exception:
+        return cfg, None
+
