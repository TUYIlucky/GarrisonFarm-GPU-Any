+def _norm_strategy_name(name):
+    """策略名归一化：OCR 偶尔把同一个策略读成繁体/异体字（如「伊奧莱塔」/「伊奥莱塔」），
+    会让同一个策略被当成两个、重复刷取。这里做一个轻量的繁简映射，
+    只处理 OCR 在策略名上实际会混淆的高频字，不引入额外依赖。"""
+    if not name:
+        return name
+    table = str.maketrans({
+        "奧": "奥", "歐": "欧", "爾": "尔", "絲": "丝", "維": "维", "亞": "亚",
+        "貝": "贝", "諾": "诺", "瑪": "玛", "麗": "丽", "萊": "莱", "蓋": "盖",
+        "羅": "罗", "薩": "萨", "倫": "伦", "傑": "杰", "茲": "兹", "凱": "凯",
+        "德": "德", "靈": "灵", "爾": "尔", "維": "维", "絲": "丝", "緹": "缇",
+        "婭": "娅", "葉": "叶", "蓮": "莲", "潔": "洁", "瓊": "琼", "瓏": "珑",
+        "貓": "猫", "龍": "龙", "鳳": "凤", "鶴": "鹤", "鷹": "鹰", "馬": "马",
+        "鳥": "鸟", "魚": "鱼", "點": "点", "線": "线", "練": "练", "級": "级",
+        "屬": "属", "國": "国", "學": "学", "術": "术", "隊": "队", "員": "员",
+    })
+    return name.translate(table).strip()
+
