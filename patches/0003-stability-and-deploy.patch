+
+    # 补全被漏检的行（徽章变绿/被遮挡时检测不到），用行距 210 外推
+    def has_card_at(y):
+        y0, y1 = max(0, y - 45), min(img.shape[0], y + 45)
+        stripe = cv2.cvtColor(img[y0:y1, 1000:1800], cv2.COLOR_BGR2GRAY).astype(np.float32)
+        return stripe.std() > 22
+
+    filled = list(rowy)
