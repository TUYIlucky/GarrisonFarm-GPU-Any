+def _adb_shot_once():
+    """直接用 adb 截一张图（maafw 不可用时的兜底），失败返回 None"""
+    try:
+        raw = subprocess.run([ADB, "-s", DEV, "exec-out", "screencap", "-p"],
+                             capture_output=True, creationflags=NOWIN, timeout=20).stdout
+        if not raw:
+            return None
+        img = cv2.imdecode(np.frombuffer(raw, np.uint8), cv2.IMREAD_COLOR)
+        if img is None:
+            return None
+        if img.shape[1] < img.shape[0]:
+            img = cv2.rotate(img, cv2.ROTATE_90_COUNTERCLOCKWISE)
+        if img.shape[:2] != (1080, 1920):
+            img = cv2.resize(img, (1920, 1080))
+        return img
+    except Exception:
+        return None
+
