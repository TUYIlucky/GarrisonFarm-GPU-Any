+def _wait_screen_stable(min_wait=2.0, timeout=8.0):
+    """等界面切换完成：连续两次截图都成功且画面基本一致，视为稳定。
+    用于跳过「界面切换导致截图失败」的窗口，避免走到重连流程。"""
+    t0 = time.time()
+    time.sleep(min_wait)
+    prev = None
+    while time.time() - t0 < timeout:
+        try:
+            img = MC.shot() if MC is not None else _adb_shot_once()
+        except Exception:
+            img = None
+        if img is not None and img.mean() > 1:
+            if prev is not None:
+                try:
+                    # 画面基本没变 -> 动画结束，界面稳定
+                    diff = float(cv2.absdiff(prev, img).mean())
+                    if diff < 2.0:
+                        return True
+                except Exception:
+                    return True
+            prev = img
+        else:
+            prev = None
+        time.sleep(0.35)
+    return False
 
 
