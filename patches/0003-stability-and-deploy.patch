+def grid_from_badges(img):
+    """按卡片右上角的星级徽章定位真实网格，返回 (xs, ys, ok)。
+
+    徽章是 26x31 的白色小图标，每张卡右上角各一个，位置很稳定
+    （深色人像卡、选中态、未解锁空位都不影响它），比"卡片亮区"可靠。
+    徽章中心 -> 卡片中心 的偏移实测为 (-42, +48)。
+    """
+    white = cv2.inRange(img, (205, 205, 205), (255, 255, 255))
+    n, _lab, stats, _cent = cv2.connectedComponentsWithStats(white, 8)
+    pts = []
+    for i in range(1, n):
+        x, y, w, h, a = stats[i]
+        cx, cy = x + w // 2, y + h // 2
+        if 23 <= w <= 31 and 27 <= h <= 35 and 400 < cx < 1800 and 250 < cy < 1060:
+            pts.append((int(cx), int(cy)))
+    if len(pts) < 3:
+        return None, None, False
+
+    # 4 列徽章的 x 是固定的，用"与标准列位置接近"判定，
+    # 不要求每列都有多个（滚动到分组边界时某些列可能只剩 1 个）
+    RAW_COL_X = [1135, 1345, 1555, 1765]
+    COL_TOL = 25
+    colx = []
+    for want in RAW_COL_X:
+        near = [p for p in pts if abs(p[0] - want) <= COL_TOL]
+        colx.append(min(near, key=lambda p: abs(p[0] - want))[0] if near else want)
+    if sum(1 for p in pts if any(abs(p[0] - c) <= COL_TOL for c in RAW_COL_X)) < 3:
+        return None, None, False
+
+    def cluster(vals, tol=18):
+        vals = sorted(vals)
+        groups = []
+        for v in vals:
+            if groups and v - groups[-1][-1] <= tol:
+                groups[-1].append(v)
+            else:
+                groups.append([v])
+        return [int(sum(g) / len(g)) for g in groups]
+
+    # 只保留徽章确实落在标准列上的行（剔除分组标题旁的白色小图标）
+    rowy = [r for r in cluster([p[1] for p in pts])
+            if any(abs(p[1] - r) <= 18 and any(abs(p[0] - c) <= COL_TOL for c in RAW_COL_X)
+                   for p in pts)]
+    if not rowy:
